    {
      "name": "4. Resumo financeiro",
      "item": [
        {
          "name": "Resumo geral",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/financial-summary",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "financial-summary"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Campos do modelo do enunciado', function () {",
                  "  pm.expect(body).to.include.keys('total_orders', 'total_revenue', 'average_order_value', 'by_status', 'by_payment_method');",
                  "});",
                  "",
                  "pm.test('Media = receita / quantidade', function () {",
                  "  if (body.total_orders > 0) {",
                  "    pm.expect(body.average_order_value).to.be.closeTo(body.total_revenue / body.total_orders, 0.01);",
                  "  }",
                  "});",
                  "",
                  "pm.test('Soma de by_status = total_orders', function () {",
                  "  const soma = Object.values(body.by_status).reduce(function (s, n) { return s + n; }, 0);",
                  "  pm.expect(soma).to.eql(body.total_orders);",
                  "});",
                  "",
                  "pm.test('by_payment_method com count e total, somando o total geral', function () {",
                  "  let contagem = 0;",
                  "  let receita = 0;",
                  "  Object.values(body.by_payment_method).forEach(function (m) {",
                  "    pm.expect(m).to.have.all.keys('count', 'total');",
                  "    contagem += m.count;",
                  "    receita += m.total;",
                  "  });",
                  "  pm.expect(contagem).to.eql(body.total_orders);",
                  "  pm.expect(receita).to.be.closeTo(body.total_revenue, 0.05);",
                  "});",
