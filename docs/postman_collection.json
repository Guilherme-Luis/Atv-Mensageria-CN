    {
      "name": "3. Pedido e itens",
      "item": [
        {
          "name": "Detalhe do pedido",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{uuid}}",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{uuid}}"]
            },
            "description": "Retorna o payload completo do pedido, no mesmo contrato recebido do Pub/Sub."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const p = pm.response.json();",
                  "",
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Campos de primeiro nivel do payload', function () {",
                  "  pm.expect(p).to.include.keys('uuid', 'created_at', 'channel', 'total', 'status', 'customer', 'seller', 'items', 'shipment', 'payment', 'metadata', 'indexed_at');",
                  "});",
                  "",
                  "pm.test('customer completo', function () {",
                  "  pm.expect(p.customer).to.include.keys('id', 'name', 'email', 'document');",
                  "});",
                  "",
                  "pm.test('seller completo', function () {",
                  "  pm.expect(p.seller).to.include.keys('id', 'name', 'city', 'state');",
                  "});",
                  "",
                  "pm.test('shipment completo', function () {",
                  "  pm.expect(p.shipment).to.include.keys('carrier', 'service', 'status', 'tracking_code');",
                  "});",
                  "",
                  "pm.test('payment completo', function () {",
                  "  pm.expect(p.payment).to.include.keys('method', 'status', 'transaction_id');",
                  "});",
                  "",
                  "pm.test('metadata completo', function () {",
                  "  pm.expect(p.metadata).to.include.keys('source', 'user_agent', 'ip_address');",
                  "});",
                  "",
                  "pm.test('Itens com produto, categoria e subcategoria', function () {",
                  "  p.items.forEach(function (item) {",
                  "    pm.expect(item).to.include.keys('id', 'product', 'unit_price', 'quantity', 'category', 'total');",
                  "    pm.expect(item.product).to.include.keys('id', 'title');",
                  "    if (item.category) {",
                  "      pm.expect(item.category).to.include.keys('id', 'name');",
                  "    }",
                  "  });",
                  "});",
                  "",
                  "pm.test('Total de cada item = unit_price x quantity', function () {",
                  "  p.items.forEach(function (item) {",
                  "    pm.expect(item.total).to.be.closeTo(item.unit_price * item.quantity, 0.01);",
                  "  });",
                  "});",
                  "",
                  "pm.test('Total do pedido = soma dos itens', function () {",
                  "  const soma = p.items.reduce(function (s, i) { return s + i.total; }, 0);",
                  "  pm.expect(p.total).to.be.closeTo(soma, 0.01);",
                  "});",
                  "",
                  "pm.test('created_at e indexed_at em ISO 8601', function () {",
                  "  pm.expect(new Date(p.created_at).toString()).to.not.eql('Invalid Date');",
                  "  pm.expect(new Date(p.indexed_at).toString()).to.not.eql('Invalid Date');",
                  "});"
