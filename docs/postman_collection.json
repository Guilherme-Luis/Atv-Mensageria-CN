    {
      "name": "1. Listagem e paginacao",
      "item": [
        {
          "name": "Listar pedidos (pagina 1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders?page=1&page_size=5",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "5" }
              ]
            },
            "description": "Lista paginada com o payload completo de cada pedido."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Envelope com data, pagination, sort e filters', function () {",
                  "  pm.expect(body).to.have.all.keys('data', 'pagination', 'sort', 'filters');",
                  "});",
                  "",
                  "pm.test('Respeita o page_size', function () {",
                  "  pm.expect(body.data.length).to.be.at.most(5);",
                  "  pm.expect(body.pagination.page_size).to.eql(5);",
                  "});",
                  "",
                  "pm.test('Pagination com contadores coerentes', function () {",
                  "  const p = body.pagination;",
                  "  pm.expect(p.total_items).to.be.a('number');",
                  "  pm.expect(p.total_pages).to.eql(Math.ceil(p.total_items / p.page_size));",
                  "  pm.expect(p.has_previous).to.eql(false);",
                  "});",
                  "",
                  "pm.test('Cada pedido traz o payload completo', function () {",
                  "  body.data.forEach(function (pedido) {",
                  "    pm.expect(pedido).to.include.keys('uuid', 'created_at', 'channel', 'total', 'status', 'customer', 'seller', 'items', 'shipment', 'payment', 'metadata');",
                  "    pm.expect(pedido.customer).to.include.keys('id', 'name', 'email', 'document');",
                  "    pm.expect(pedido.items).to.be.an('array');",
                  "  });",
                  "});",
                  "",
                  "pm.test('Total do pedido = soma de unit_price x quantity', function () {",
                  "  body.data.forEach(function (pedido) {",
                  "    const soma = pedido.items.reduce(function (s, i) { return s + i.unit_price * i.quantity; }, 0);",
                  "    pm.expect(pedido.total).to.be.closeTo(soma, 0.01);",
                  "  });",
                  "});",
                  "",
                  "if (body.data.length) {",
                  "  pm.collectionVariables.set('uuidEncontrado', body.data[0].uuid);",
                  "}"
                ]
              }
            }
          ]
        },
